<?xml version="1.0" encoding="utf-8"?>
<!-- Az indítóképernyő animációja (Android 12+): a jelvény "felpattan", a kontúr kirajzolódik,
     majd a lapok sorban felgyúlnak. Teljes hossza 900 ms alatt marad (a rendszer limitje 1000 ms). -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_splash_diamond_anim">
    <target android:name="mark">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="520"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleX"
                    android:valueFrom="0.55"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="520"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleY"
                    android:valueFrom="0.55"
                    android:valueTo="1"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="outline">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="600"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="silhouette">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="380"
                android:propertyName="fillAlpha"
                android:startOffset="180"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="facetUpper">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="300"
                android:propertyName="fillAlpha"
                android:startOffset="360"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="facetRight">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="300"
                android:propertyName="fillAlpha"
                android:startOffset="430"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="facetLower">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="300"
                android:propertyName="fillAlpha"
                android:startOffset="500"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="facetFar">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="300"
                android:propertyName="fillAlpha"
                android:startOffset="570"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
